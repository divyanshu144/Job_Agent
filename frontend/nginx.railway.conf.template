# Railway frontend config. Rendered by the nginx image's envsubst step, so the
# ${...} values below come from service variables (defaults set in the Dockerfile).
#
# The browser only ever talks to this origin: static files are served here and
# /api/ is proxied to the api service over Railway's private network. That keeps the
# cookie-JWT auth same-origin (no CORS / SameSite juggling).
server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Railway private DNS. The upstream is resolved per request (variable in
    # proxy_pass), so the frontend can boot before the api service is reachable.
    resolver ${DNS_RESOLVER} valid=10s;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        set $api_upstream "http://${API_UPSTREAM}";
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        # SSE analysis stream: the api sends X-Accel-Buffering: no; the long read
        # timeout covers the slow phase-1 agents.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
