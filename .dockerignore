# Keep the build context small and free of secrets/dev cruft. The Dockerfile
# builds the frontend from source and copies backend/, alembic/, data/ (only
# data/.gitkeep is tracked), so everything below is safe to exclude.

# VCS + CI
.git
.github

# Secrets / local env
.env
.env.*
!.env.example

# Python caches & tooling
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
*.egg-info/
.venv/

# Node: reinstalled inside the frontend build stage; dist is rebuilt there
frontend/node_modules/
frontend/dist/

# Local data the image must never bake in (cv.pdf, jobfit.db, profile yaml)
data/*.db
data/*.pdf
data/candidate_profile.yaml

# Tests + docs aren't needed in the runtime image
tests/
docs/
tasks/
*.md
