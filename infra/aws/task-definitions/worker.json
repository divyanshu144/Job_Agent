{
  "family": "jobfit-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::896476315730:role/jobfit-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::896476315730:role/jobfit-ecs-task-role",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "worker",
      "image": "896476315730.dkr.ecr.eu-west-2.amazonaws.com/jobfit-worker:latest",
      "essential": true,
      "command": ["celery", "-A", "backend.celery_app:celery_app", "worker", "--loglevel=info"],
      "environment": [
        { "name": "APP_ENV", "value": "production" },
        { "name": "API_PREFIX", "value": "/api" },
        { "name": "DB_SSL", "value": "false" },
        { "name": "CORS_ORIGINS", "value": "https://app.jobfitapp.uk" },
        { "name": "COOKIE_SECURE", "value": "true" },
        { "name": "LOG_LEVEL", "value": "INFO" },
        { "name": "ANTHROPIC_MAX_RETRIES", "value": "3" },
        { "name": "EMBEDDING_PROVIDER", "value": "openai" },
        { "name": "EMBEDDING_MODEL", "value": "text-embedding-3-small" },
        { "name": "EMBEDDING_DIMENSIONS", "value": "1536" },
        { "name": "PGVECTOR_ENABLED", "value": "true" },
        { "name": "CV_PATH", "value": "/app/data/cv.pdf" },
        { "name": "PROFILE_YAML_PATH", "value": "/app/data/candidate_profile.yaml" },
        { "name": "ENABLE_WORKATASTARTUP_SOURCE", "value": "false" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:ssm:eu-west-2:896476315730:parameter/jobfit/staging/database-url" },
        { "name": "REDIS_URL", "valueFrom": "arn:aws:ssm:eu-west-2:896476315730:parameter/jobfit/staging/redis-url" },
        { "name": "CELERY_BROKER_URL", "valueFrom": "arn:aws:ssm:eu-west-2:896476315730:parameter/jobfit/staging/celery-broker-url" },
        { "name": "CELERY_RESULT_BACKEND", "valueFrom": "arn:aws:ssm:eu-west-2:896476315730:parameter/jobfit/staging/celery-result-backend" },
        { "name": "JWT_SECRET", "valueFrom": "arn:aws:ssm:eu-west-2:896476315730:parameter/jobfit/staging/jwt-secret" },
        { "name": "ANTHROPIC_API_KEY", "valueFrom": "arn:aws:ssm:eu-west-2:896476315730:parameter/jobfit/staging/anthropic-api-key" },
        { "name": "OPENAI_API_KEY", "valueFrom": "arn:aws:ssm:eu-west-2:896476315730:parameter/jobfit/staging/openai-api-key" },
        { "name": "SENTRY_DSN", "valueFrom": "arn:aws:ssm:eu-west-2:896476315730:parameter/jobfit/staging/sentry-dsn" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "celery -A backend.celery_app:celery_app inspect ping --timeout=5 >/dev/null || exit 1"],
        "interval": 60,
        "timeout": 15,
        "retries": 3,
        "startPeriod": 90
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/jobfit-worker",
          "awslogs-region": "eu-west-2",
          "awslogs-stream-prefix": "worker"
        }
      }
    }
  ]
}
