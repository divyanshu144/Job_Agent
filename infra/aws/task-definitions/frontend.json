{
  "family": "jobfit-frontend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::896476315730:role/jobfit-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::896476315730:role/jobfit-ecs-task-role",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "frontend",
      "image": "896476315730.dkr.ecr.eu-west-2.amazonaws.com/jobfit-frontend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "environment": [],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://127.0.0.1/healthz >/dev/null || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/jobfit-frontend",
          "awslogs-region": "eu-west-2",
          "awslogs-stream-prefix": "frontend"
        }
      }
    }
  ]
}
