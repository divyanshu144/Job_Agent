# Required for real LLM calls. Leave empty only when running mocked tests.
ANTHROPIC_API_KEY=

# Docker Compose overrides DATABASE_URL and REDIS_URL for container services.
# These localhost defaults are useful for non-Docker local development.
DATABASE_URL=postgresql+asyncpg://jobfit:jobfit@localhost:5432/jobfit
DB_SSL=false
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

API_PREFIX=/api
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
LOG_LEVEL=INFO
ANTHROPIC_MAX_RETRIES=3

# Set a long random value before exposing the app beyond local development.
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE_MINUTES=10080
COOKIE_SECURE=false

# Local/default profile inputs. Docker Compose maps these to /app/data/*.
CV_PATH=data/cv.pdf
PROFILE_YAML_PATH=data/candidate_profile.yaml

# Optional integrations.
HUNTER_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
REED_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ENABLE_WORKATASTARTUP_SOURCE=false
