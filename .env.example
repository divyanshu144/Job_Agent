# Required for real LLM calls. Store in AWS Secrets Manager or SSM for ECS.
# Leave empty only when running mocked tests.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Docker Compose overrides DATABASE_URL and REDIS_URL for container services.
# These localhost defaults are useful for non-Docker local development.
# Store DATABASE_URL/REDIS_URL/CELERY_* in AWS Secrets Manager or SSM for ECS.
DATABASE_URL=postgresql+asyncpg://jobfit:jobfit@localhost:5432/jobfit
DB_SSL=false
RUN_MIGRATIONS_ON_STARTUP=true
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

API_PREFIX=/api
APP_ENV=development
# For AWS staging/prod, set this to the exact HTTPS frontend origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
LOG_LEVEL=INFO
ANTHROPIC_MAX_RETRIES=3
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
PGVECTOR_ENABLED=true

# Store JWT_SECRET in AWS Secrets Manager or SSM. Set a long random value before
# exposing the app beyond local development. APP_ENV=production refuses this
# published default.
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE_MINUTES=10080
# Use true behind HTTPS in AWS.
COOKIE_SECURE=false

# Local/default profile inputs. Docker Compose maps these to /app/data/*.
CV_PATH=data/cv.pdf
PROFILE_YAML_PATH=data/candidate_profile.yaml

# Optional integrations. Store non-empty values in AWS Secrets Manager or SSM.
HUNTER_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
REED_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ENABLE_WORKATASTARTUP_SOURCE=false
